# jalan bila ingin varian lain.
KIMI_MODEL=kimi-k2-thinking # kimi-k2.5 | kimi-k2.6 | kimi-k3
# Base URL resmi Moonshot AI (OpenAI-compatible, endpoint /chat/completions):
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MAX_TOKENS=4096
KIMI_TEMPERATURE=1.0
# ⚠️ kimi-k3 HANYA menerima top_p=0.95 (API menolak nilai lain dengan
# "invalid top_p: only 0.95 is allowed for this model"). Jangan ubah ke 1.0.
KIMI_TOP_P=0.95
# M126 (21 Agu 2026): AI_PRIMARY_PROVIDER=kimi di atas, dan var ini TADINYA
# tidak diisi → axios memakai default 90000ms (services/kimiService.js).
# Kimi kerap mendekati/melewati 90 detik untuk prompt WhatsApp proyek ini
# (±67K token) — ini KEMUNGKINAN BESAR penyebab customer melihat balasan AI
# baru datang setelah >2 menit (90 detik timeout + 12 detik debounce respon +
# waktu proses). Diturunkan ke 30 detik sesuai permintaan pemilik proyek —
# begitu Kimi melebihi ini, fallback ke Private Agent langsung jalan alih-alih
# customer menunggu penuh 90 detik. Trade-off: balasan yang SEBENARNYA akan
# berhasil dalam 30-90 detik kini jatuh ke Private Agent (fallback, jawaban
# lebih terbatas/deterministik) alih-alih AI penuh. Naikkan lagi bila terlalu
# banyak fallback yang seharusnya tidak perlu.
KIMI_TIMEOUT_MS=30000

# ============================================
