# JWT Secrets — ganti dengan string random sebelum production
ACCESS_TOKEN_SECRET=elevan_access_secret_iuewg928g0wbigw78981091nLJkosniqLwq83egijc
REFRESH_TOKEN_SECRET=elevan_refresh_secret_837qbdgwosDapoznchvdo07sNckaidskjajwiuq98y8

# Expiry token — sesuai jsonwebtoken expiresIn format (60s, 5m, 2h, 1d)
# Access token expire setiap 5 menit (frontend auto-refresh ke /refreshTokenController)
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=1d

# Cookie name untuk menyimpan refresh_token (HttpOnly)
COOKIE_REFRESH_TOKEN=Elevan_Refresh_Token

# Bcrypt salt rounds (10-12 recommended)
BCRYPT_SALT_ROUNDS=10

# ==============================================================
# HTTP STATUS CODES (untuk konsistensi respon controller)
# ==============================================================
HTTP_OK=200
HTTP_CREATED=201
HTTP_NO_CONTENT=204
HTTP_BAD_REQUEST=400
HTTP_UNAUTHORIZED=401
HTTP_REJECTION=402
HTTP_FORBIDDEN=403
HTTP_NOT_FOUND=404
HTTP_CONFLICT=409
HTTP_INTERNAL_SERVER_ERROR=500
HTTP_NOT_IMPLEMENTED=501
HTTP_BAD_GATEWAY=502
HTTP_SERVICE_UNAVAILABLE=503

# ==============================================================
# Catalog Chat Settings
# ==============================================================
# Hanya jalan saat pemberian summary saja, ON = Chatbot merespon summary dengan catalog, OFF = Chatbot merespon summary tanpa catalog
RESPOND_CATALOG_RUN=ON

PAGINATION_ROWS=8
# ─── RAG (M134): diaktifkan atas permintaan pemilik proyek 24 Agu 2026 ───
# Indeks dibangun offline: node scripts/build-rag-index.js --skip-db --only=skills
# Mode `local` = hashing-trick tanpa jaringan. Kualitas retrieval lebih rendah
# daripada `openai` pada query pendek (lihat §5 M92) — set ke openai begitu
# CHAT_GPT_API_KEY yang valid tersedia.
RAG_ENABLED=ON
RAG_EMBEDDING_MODE=local
RAG_EMBEDDING_CONFIDANCE_SCORE=0.35

# ─── Gambar Properti — kirim via WhatsApp (M165, 29 Agu 2026) ───────────────
# Sebelumnya TIDAK ADA sama sekali di berkas ini, sehingga
# PROPERTY_IMAGE_SEND_ENABLED jatuh ke default 'OFF' dan Kirimi tidak pernah
# dipakai untuk mengirim foto — yang sampai ke customer cuma teks path mentah
# "/assets/image_data/properties/house.png" di dalam kartu (keluhan pemilik
# proyek). Tag markdown itu sudah dihapus dari kartu; ini menyalakan jalur
# gambar sungguhannya (field media_url Kirimi).
PROPERTY_IMAGE_SEND_ENABLED=ON
PROPERTY_IMAGE_MAX_PER_REPLY=3

# Lokasi FISIK aset frontend — pindah dari public/assets ke src/assets
# (instruksi pemilik proyek 29 Agu 2026). Isi kedua direktori sudah identik
# (diverifikasi dengan diff -rq: nihil), jadi perpindahan ini aman.
PROPERTY_IMAGE_DIR=../frontend/src/assets/image_data
PROPERTY_IMAGE_URL_BASE=/assets/image_data

# WAJIB diisi domain sungguhan di PRODUKSI. Kosong = fallback ke tunnel ngrok
# aktif (dev only). Kirimi butuh URL yang bisa diakses dari INTERNET.
PROPERTY_IMAGE_PUBLIC_BASE_URL=


