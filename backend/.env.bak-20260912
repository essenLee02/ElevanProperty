# ==============================================================
# FONNTE SEND — Timeout & Retry untuk pengiriman pesan WhatsApp
# ==============================================================
# FONNTE_TIMEOUT_MS   : waktu tunggu koneksi per percobaan (ms)
#                       Default 30000 (30 detik)
# FONNTE_RETRY_COUNT  : jumlah percobaan ulang jika ETIMEDOUT / ECONNRESET
#                       Default 3 (total 3 kali, termasuk percobaan pertama)
# FONNTE_RETRY_DELAY_MS : jeda awal antar percobaan (ms) — meningkat linear
#                         Percobaan 1→2: 1× delay, 2→3: 2× delay, dst.
#                         Default 3000 (3 detik, 6 detik, ...)
FONNTE_TIMEOUT_MS=90000
FONNTE_RETRY_COUNT=3
FONNTE_RETRY_DELAY_MS=3000

