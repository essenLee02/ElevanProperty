# ==============================================================
# NGROK — auto-start tunnel dari dalam terminal backend
# ==============================================================
# NGROK_ENABLE=true  → backend otomatis jalankan `ngrok http <PORT>` sebagai
#                       child process saat start, URL public muncul di terminal
#                       backend yang sama (tidak perlu window ngrok.exe terpisah)
# NGROK_ENABLE=false → ngrok tidak dijalankan, jalankan manual jika perlu
# NGROK_ENABLE=false → ngrok tidak dijalankan, jika NGROK_WEBHOOK_URL ada url-nya, maka webhook dijalankan pada platform hosting seperti Hostinger, Railway, Render, dll. (bila platform sudah menyediakan URL publik sendiri)
NGROK_AUTHTOKEN=3CTVG7OWPXEAjVWgRhHIyH8XUsc_5YbFsXj2DTR7Lsb6uZiSD
NGROK_ENABLE=true # true/false
# NGROK_EXE_PATH — BARU (23 Agu 2026). Jalur PASTI ke ngrok.exe, melewati
# pencarian PATH OS sama sekali. Ditambahkan setelah bug nyata: menjalankan
# `nodemon` dari shell dengan Python venv aktif (python_backend\.venv) membuat
# PATH memilih ngrok BAWAAN pyngrok (python_backend\.venv\Scripts\ngrok.exe)
# alih-alih ngrok asli — dan Windows Defender MEMBLOKIR copy pyngrok itu
# (WinError 225 "file contains a virus or potentially unwanted software").
# Gejalanya terlihat seperti "ngrok timeout" biasa, padahal proses child gagal
# start sama sekali. Dua ngrok ASLI yang terverifikasi jalan di mesin ini:
#   C:\Users\HP\AppData\Local\Microsoft\WindowsApps\ngrok.exe   (v3.39.9)
#   C:\Users\HP\AppData\Roaming\npm\ngrok.cmd                    (v3.39.4)
# Kosong = fallback ke 'ngrok' polos (perilaku lama) — TAPI itu rentan
# terulang bila backend pernah dijalankan dari shell venv aktif. Diisi di
# bawah untuk mencegahnya permanen, terlepas dari shell mana yang dipakai.
NGROK_EXE_PATH=C:\Users\HP\AppData\Local\Microsoft\WindowsApps\ngrok.exe
NGROK_WEBHOOK_URL=https://propmatches.fun/api/kirimi/webhook # NGROK_ENABLE=false | Saat NGROK_ENABLE bernilai false, maka Webhook terminal Massage berada di Hostinger -> Hostinger : https://propmatches.fun/api/kirimi/webhook
# Opsional — reserved domain (ngrok paid plan), kosongkan jika pakai domain random:
# NGROK_DOMAIN=your-reserved-domain.ngrok-free.app
# Opsional — region tunnel (us | eu | ap | au | sa | jp | in), kosongkan untuk default:
# NGROK_REGION=ap

# ⛔ KEBIJAKAN BILLING — WAJIB DIPATUHI (3 Agu 2026):
# Untuk SEMUA provider AI di bawah (ChatGPT, Kimi, Qwen, DeepSeek, Claude):
# DILARANG KERAS melakukan auto-recharge/auto-topup saat token/kredit habis,
# baik lewat kode, script, maupun UI otomatis apa pun. Saat kuota habis:
#   -> service melempar error -> provider chain jatuh ke provider berikutnya
#      (lihat aiProviderService.js) -> akhirnya fallback ke Private Agent.
# Isi ulang kredit HANYA dilakukan manual oleh owner lewat dashboard billing
# masing-masing provider. JANGAN pernah menambahkan kode yang memanggil
# endpoint billing/payment provider mana pun secara otomatis.
CHAT_GPT_API_KEY=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
# ⚠️ 3 Agu 2026: 'gpt-oss-20b' DAN 'gpt-5.6-terra-pro' dites LANGSUNG ke API
# Responses ini — keduanya HTTP 400 "The requested model '...' does not exist."
# Dites juga 'gpt-4o-mini' dan 'gpt-4.1-mini' → KEDUANYA berhasil. Diset ke
# gpt-4o-mini (sudah teruji stabil di sesi-sesi sebelumnya, termasuk analisis
# batas TPM). Ganti ke gpt-4.1-mini bila ingin mencoba varian lain — sama-sama
# terverifikasi jalan dengan key ini.
CHAT_GPT_MODEL=o4-mini # gpt-4o-mini
CHAT_GPT_STORE_RESPONSE=true
CHAT_GPT_MAX_OUTPUT_TOKENS=4096
CHAT_GPT_TIMEOUT_MS=30000

