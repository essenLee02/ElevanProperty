# Nama model OpenRouter, format "vendor/model" (mis. "openai/gpt-4o-mini",
# "anthropic/claude-3-haiku", "deepseek/deepseek-chat"). "stealth/ox-alpha"
# adalah model cloaked/eksperimental OpenRouter — cocok untuk uji coba,
# tapi bisa ditarik OpenRouter sewaktu-waktu tanpa pemberitahuan. Ganti ke
# model biasa (mis. "openai/gpt-4o-mini") untuk produksi jangka panjang.
OPENROUTER_MODEL=openai/gpt-4.1 # moonshotai/kimi-k2.6 | stealth/ox-alpha
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TIMEOUT_MS=30000

# ⭐ M183 (6 Sep 2026) — dua timeout ini SUDAH dibaca kode tapi TIDAK PERNAH ada
# di .env, jadi diam-diam memakai default hardcode. Dieksplisitkan supaya semua
# batas waktu bisa diatur dari satu tempat (konvensi proyek: nol hardcode).
# PYTHON_MIRROR_TIMEOUT_MS : mirror webhook ke python_backend (services/
#   pythonMirrorService.js, default lama 4000). Mirror bersifat fire-and-forget —
#   JANGAN dibesarkan, karena menahan giliran balasan customer tanpa manfaat.
PYTHON_MIRROR_TIMEOUT_MS=4000
# RAG_EMBEDDING_TIMEOUT_MS : panggilan embedding saat retrieval (services/
#   embeddingService.js, default lama 20000). Mode `local` tidak memakai jaringan
#   sama sekali, jadi nilai ini hanya berlaku untuk mode `openai`/HTTP.
RAG_EMBEDDING_TIMEOUT_MS=20000

# chatgpt | claude | qwen | deepseek | kimi | openrouter | private (private = chatbotPrivateController, untuk testing fitur baru sebelum deploy ke public)
