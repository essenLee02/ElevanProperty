PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_property
DB_DIALECT=mysql

GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_TAB_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_STORE_RESPONSE=true
OPENAI_MAX_OUTPUT_TOKENS=0

# AI provider routing
AI_PRIMARY_PROVIDER=chatgpt
ENABLE_CLAUDE_FALLBACK=true
ENABLE_CHATBOT_PRIVATE_CONTROLLER=true

# Claude / Anthropic API
ANTHROPIC_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_API_VERSION=2023-06-01
CLAUDE_MAX_TOKENS=1200

FONNTE_TOKEN=your_fonnte_token
ENABLE_AI_WHATSAPP=true

# Fonnte send timeout & retry (atur jika sering ETIMEDOUT ke api.fonnte.com)
FONNTE_TIMEOUT_MS=30000
FONNTE_RETRY_COUNT=3
FONNTE_RETRY_DELAY_MS=3000

# Chatbot profile cookie/session TTL in minutes.
CHATBOT_COOKIE_TTL_MINUTES=20

# Mode summary/katalog — FALLBACK GLOBAL saja. Sumber kebenaran per-agent adalah
# kolom users.catalog_summary ('ON' = summary + katalog, 'OFF' = summary saja),
# yang bisa diubah agent langsung via chat WhatsApp ke bot-nya sendiri:
#   "matikan summary" / "saya mau summary off"  → catalog_summary=OFF
#   "nyalakan summary" / "aktifkan summary"     → catalog_summary=ON
# Env ini hanya dipakai bila kolom masih NULL / agent tidak dikenal.
RESPOND_CATALOG_RUN=OFF

# Skill prompt loader limits.
SKILL_MAX_WEBSITE_CHARACTERS=12000
SKILL_MAX_RESPONSE_CHARACTERS=22000
SKILL_MAX_PROJECT_CHARACTERS=36000

# Pagination — jumlah baris per halaman di semua halaman list master data.
# Contoh: PAGINATION_ROWS=5 → data ke-6 masuk ke halaman 2, dst.
PAGINATION_ROWS=5

# ── GAMBAR PROPERTI (upload master property) ─────────────────────────────────
# PROPERTY_IMAGE_DIR      : direktori FISIK root gambar, relatif terhadap backend/.
#                           Upload user → <root>/<PROPERTY_ID>/
#                           Gambar default bersama → <root>/properties/
# PROPERTY_IMAGE_URL_BASE : prefix URL yang disimpan ke property_images.url.
#                           HARUS cocok dengan layout public frontend, karena
#                           ribuan baris lama sudah memakai /assets/image_data/...
# PROPERTY_IMAGE_DEFAULT_DIR : nama folder default BERSAMA. File di folder ini
#                           TIDAK PERNAH dihapus saat user menghapus gambar
#                           (dipakai banyak properti sekaligus).
PROPERTY_IMAGE_DIR=../frontend/public/assets/image_data
PROPERTY_IMAGE_URL_BASE=/assets/image_data
PROPERTY_IMAGE_DEFAULT_DIR=properties
PROPERTY_IMAGE_MAX_MB=5
PROPERTY_IMAGE_MAX_FILES=10

# Google Calendar API — Viewing/Survey Appointment Scheduling
# API Key TIDAK bisa dipakai untuk create event (Google menolak, wajib OAuth2/Service
# Account). Reuse GOOGLE_SERVICE_ACCOUNT_JSON_PATH yang sudah dipakai googleSheetsService.js.
# Setiap agent WAJIB share Google Calendar mereka ke client_email Service Account
# (permission "Make changes to events") — lihat backend/VIEWING_SCHEDULE_API.md.
GOOGLE_CALENDAR_TIMEZONE=Asia/Jakarta
