    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
