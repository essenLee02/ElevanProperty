    {
      "name": "🔗 Advanced - Direct URL & Raw Data",
      "item": [
        {
          "name": "🌐 Scrape dari URL Langsung",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response Status 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "console.log('✅ Scraped from URLs:', response.data.meta.total + ' listings');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startUrls\": [\n    \"https://www.rumah123.com/jual/dki-jakarta/rumah/\",\n    \"https://www.rumah123.com/jual/bali/villa/\"\n  ],\n  \"limit\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/rumah123/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "search"]
            },
            "description": "Ambil data langsung dari URL Rumah123 (tanpa filter built-in, langsung dari search page)"
          },
          "response": []
        },
        {
          "name": "📊 Raw Data dari Apify (Semua Field)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingType\": \"sale\",\n  \"location\": \"Jakarta Selatan\",\n  \"propertyType\": [\"house\"],\n  \"limit\": 5,\n  \"raw\": true\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/rumah123/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "search"]
            },
            "description": "Lihat raw data lengkap dari Apify dengan semua field yang tersedia (tidak di-transform)"
          },
          "response": []
        },
        {
          "name": "📋 Ambil Dataset yang Sudah Ada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ganti dataset_id dengan ID dari response sebelumnya",
                  "// Contoh: datset_ABC123XYZ",
                  "let datasetId = pm.environment.get('dataset_id');",
                  "if(!datasetId) {",
                  "  console.warn('⚠️ dataset_id belum di-set. Jalankan search request terlebih dahulu!');",
                  "} else {",
                  "  console.log('📊 Using dataset ID:', datasetId);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response Status 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "console.log('📋 Total listings in dataset:', response.data.meta.total);",
                  "console.log('📊 Current page:', response.data.meta.offset + ' to ' + (response.data.meta.offset + response.data.listings.length));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/rumah123/dataset/{{dataset_id}}?offset=0&limit=50",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "dataset", "{{dataset_id}}"],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Ambil data dari dataset yang sudah ada (hasil dari search sebelumnya)\n\nVariable {{dataset_id}} otomatis di-set setelah menjalankan search request"
          },
          "response": []
        }
      ]
    },
