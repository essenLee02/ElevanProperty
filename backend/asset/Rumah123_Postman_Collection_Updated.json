    {
      "name": "🏝️ Search - Premium Properties",
      "item": [
        {
          "name": "💎 Villa di Bali - Luxury",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response Status 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "let listings = response.data.listings;",
                  "",
                  "// Hitung rata-rata harga",
                  "let total = 0;",
                  "listings.forEach(l => { total += l.priceNumeric; });",
                  "let avgPrice = total / listings.length;",
                  "",
                  "console.log('💎 Villa di Bali');",
                  "console.log('Total ditemukan:', listings.length);",
                  "console.log('Rata-rata harga: Rp ' + new Intl.NumberFormat('id-ID').format(avgPrice));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingType\": \"sale\",\n  \"location\": \"Bali\",\n  \"sortOrder\": \"price-desc\",\n  \"propertyType\": [\"villa\"],\n  \"minBedrooms\": \"3\",\n  \"minBathrooms\": \"2\",\n  \"limit\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/rumah123/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "search"]
            },
            "description": "Cari villa di Bali, minimal 3 kamar tidur, urutkan harga tertinggi"
          },
          "response": []
        },
