{
  "info": {
    "_postman_id": "rumah123-apify-elevan",
    "name": "Rumah123 via Apify - Elevan Property",
    "description": "Collection API untuk scrape property dari Rumah123 menggunakan Apify\n\n⚠️ SECURITY WARNING:\nToken Apify sudah di-set. Jangan share collection ini ke public!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "elevan_property"
  },
  "item": [
    {
      "name": "🔑 Setup & Status",
      "item": [
        {
          "name": "✅ 1. Status - Cek Apify Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status OK', function() {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.to.be.json;",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "console.log('✅ Apify Token Status:', response.data.apifyTokenConfigured);",
                  "console.log('Actor ID:', response.data.actorId);",
                  "console.log('Pricing:', response.data.pricingPerResults);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/rumah123/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "status"]
            },
            "description": "Cek apakah APIFY_API_TOKEN sudah dikonfigurasi dengan benar di .env backend"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏠 Search - Dijual",
      "item": [
        {
          "name": "2️⃣ Rumah Dijual - Jakarta Selatan (10 listing)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set timestamp untuk tracking",
                  "pm.environment.set('request_time', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response Status 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function() {",
                  "  pm.response.to.be.json;",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "console.log('✅ Total listings:', response.data.meta.total);",
                  "console.log('🏃 Run ID:', response.data.meta.runId);",
                  "console.log('📊 Dataset ID:', response.data.meta.datasetId);",
                  "console.log('⏱️ Request time:', pm.environment.get('request_time'));",
                  "",
                  "// Simpan dataset ID untuk dipakai di request berikutnya",
                  "if(response.data.meta.datasetId) {",
                  "  pm.environment.set('dataset_id', response.data.meta.datasetId);",
                  "  console.log('💾 Dataset ID saved to environment');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingType\": \"sale\",\n  \"location\": \"Jakarta Selatan\",\n  \"sortOrder\": \"recommended\",\n  \"propertyType\": [\"house\"],\n  \"furnishingCondition\": [],\n  \"facilities\": [],\n  \"limit\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/rumah123/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "search"]
            },
            "description": "Cari rumah dijual di Jakarta Selatan - 10 listing pertama"
          },
          "response": []
        },
        {
          "name": "🏠 Filter Harga - 500M-3M di Jakarta Selatan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response Status 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "let listings = response.data.listings;",
                  "",
                  "// Verifikasi filter harga",
                  "listings.forEach(function(listing) {",
                  "  pm.expect(listing.priceNumeric).to.be.at.least(500000000);",
                  "  pm.expect(listing.priceNumeric).to.be.at.most(3000000000);",
                  "});",
                  "",
                  "console.log('✅ Semua listing dalam range harga 500M-3M');",
                  "console.log('📍 Total:', listings.length);",
                  "listings.slice(0, 3).forEach(function(listing, idx) {",
                  "  console.log((idx+1) + '. ' + listing.title + ' - ' + listing.price);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingType\": \"sale\",\n  \"location\": \"Jakarta Selatan\",\n  \"sortOrder\": \"price-asc\",\n  \"propertyType\": [\"house\", \"apartment\"],\n  \"minPrice\": 500000000,\n  \"maxPrice\": 3000000000,\n  \"minBedrooms\": \"2\",\n  \"minBathrooms\": \"1\",\n  \"limit\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/rumah123/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rumah123", "search"]
            },
            "description": "Cari properti dengan filter:\n- Harga: 500 juta - 3 miliar\n- Minimal 2 kamar tidur\n- Minimal 1 kamar mandi\n- Urutkan harga terendah"
          },
          "response": []
        },
        {
          "name": "🏠 Rumah Besar - 4+ Kamar di Jakarta Pusat",
          "request": {
            "method": "POST",
