# ==============================================================
# Catalog Chat Settings
# ==============================================================
# Hanya jalan saat pemberian summary saja, ON = Chatbot merespon summary dengan catalog, OFF = Chatbot merespon summary tanpa catalog
RESPOND_CATALOG_RUN=ON

PAGINATION_ROWS=8

# ==============================================================
# RAG (Retrieval-Augmented Generation) — M92/M96
# ==============================================================
# ON = AI dapat konteks tambahan dari data/rag-index.json (katalog properti
#      per-agent + referensi skill docs) saat menyusun jawaban. OFF (default
#      lama) = perilaku persis seperti sebelum RAG ada, nol token tambahan.
# Diaktifkan 15 Agu 2026 setelah indeks dibangun dari DB sungguhan: 9.167
# properti (6 agent) + 125 chunk referensi, embedding text-embedding-3-small.
# Jalankan ulang `node scripts/build-rag-index.js` (root repo, dari folder
# backend) setiap kali katalog properti berubah signifikan.
RAG_ENABLED=ON
RAG_EMBEDDING_MODE=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
# ==============================================================
# PYTHON AI REPLY (M105) — apakah Python BOLEH membalas customer?
# ==============================================================
# true  = python_backend BENAR-BENAR mengirim WhatsApp ke customer sungguhan.
# false = hanya menyusun + menampilkan di terminal (default aman).
#
# ⚠️ JANGAN nyalakan bersamaan dengan Node.js yang melayani webhook yang SAMA
# — customer akan menerima DUA balasan. Pilih SATU:
#   (a) Node.js membalas  → PYTHON_AI_REPLY_ENABLED=false, Node.js jalan
#   (b) Python membalas   → PYTHON_AI_REPLY_ENABLED=true, Node.js DIMATIKAN,
#                           dan Python memegang tunnel ngrok (ENABLE_NGROK=true)
# Pengaman tambahan: permintaan SALINAN dari Node.js (header X-Mirrored-From)
# TIDAK PERNAH dibalas Python, apa pun nilai flag ini.
PYTHON_AI_REPLY_ENABLED=true
