# ⚠️⚠️ PORT=5055 DI BAWAH SENGAJA TIDAK DIPAKAI OLEH PYTHON.
# Itu port PRODUKSI Node.js. python_backend membaca `PYTHON_PORT` (di bawahnya)
# lewat field terpisah di app/config.py — bila Python ikut bind ke 5055,
# salah satu proses gagal start, dan bila Python yang menang SELURUH webhook
# customer berhenti dibalas. Baris PORT dibiarkan agar berkas ini tetap bisa
# dibandingkan baris-per-baris dengan backend/.env saat mencari desync.
PORT=5055
PYTHON_PORT=5056
FRONTEND_PORT=5173

APP_NAME=Elevan Property
APP_URL=http://localhost

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_property
DB_DIALECT=mysql

GOOGLE_SHEET_ID=1nwy276VXH0JvDZVOoddBbqmr9jwpydoKrukWY2Jukw4
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_TAB_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json

GOOGLE_API_KEY=AIzaSyD9lR2OAPd-jprbCXu_3W4NECgb8-u8oNA

# Google Calendar (auto-schedule viewing/survey) — OAuth 2.0, bukan Service Account.
# Semua event dibuat di calendar 'primary' milik akun yang menyelesaikan consent di
# bawah — bukan calendar tiap agent (lihat komentar getOAuthClient() di
# services/googleCalendarService.js untuk alasan & detail).
GOOGLE_OAUTH_CLIENT_JSON_PATH=./asset/client_secret_282144058761-f40g1he7u5es1kjdpkug8neq01d7rqke.apps.googleusercontent.com.json
# WAJIB diisi manual SEKALI — lihat instruksi setup di getOAuthClient(). Tanpa ini,
# fitur viewing→Calendar gagal dengan pesan jelas (bukan silent/crash).
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=Asia/Jakarta

# WhatsApp terminal aktif: FONNTE | KIRIMI | TIMELINESAI
# Mempengaruhi metadata source di log AI (fonnte_whatsapp / kirimi_whatsapp / timelinesai_whatsapp)
MESSAGE_TERMINAL=KIRIMI

# ==============================================================
# NGROK — auto-start tunnel dari dalam terminal backend
# ==============================================================
# ENABLE_NGROK=true  → backend otomatis jalankan `ngrok http <PORT>` sebagai
#                       child process saat start, URL public muncul di terminal
#                       backend yang sama (tidak perlu window ngrok.exe terpisah)
# ENABLE_NGROK=false → ngrok tidak dijalankan, jalankan manual jika perlu
NGROK_AUTHTOKEN=3CTVG7OWPXEAjVWgRhHIyH8XUsc_5YbFsXj2DTR7Lsb6uZiSD
ENABLE_NGROK=true
# ⚠️ WAJIB diisi (15 Agu 2026) — domain statis gratis milik akun ini, yang
# terdaftar sebagai webhook URL di dashboard Kirimi. TANPA ini, setiap start
# ulang Node.js menghasilkan subdomain ACAK BARU, dan webhook Kirimi yang
# masih menunjuk ke domain lama akan diam-diam berhenti menerima pesan
# customer — persis insiden yang terjadi malam ini (ngrok manual sempat
# dijalankan ke arah python_backend:5056 yang belum punya webhook, seluruh
# pesan customer 404 dan tidak pernah dibalas).
NGROK_DOMAIN=spotter-dragging-sporting.ngrok-free.dev
# Opsional — region tunnel (us | eu | ap | au | sa | jp | in), kosongkan untuk default:
# NGROK_REGION=ap

# ⚠️ python_backend (M97, dev/uji manual) — TERPISAH dari NGROK_DOMAIN di atas.
# Baca app/core/ngrok_tunnel.py untuk alasan wajib dipisah (hindari dua proses
# berebut satu domain produksi — persis insiden 15 Agu 2026 malam).
# ENABLE_NGROK=true → juga dibaca python_backend/app/config.py, tunnel dibuka
# otomatis saat `python main.py` (BUKAN tunnel produksi, webhook Kirimi belum
# ada di sisi Python — jangan didaftarkan ke dashboard Kirimi).
# PYTHON_NGROK_DOMAIN=  ← kosongkan untuk subdomain acak setiap start (aman)

# ⛔ KEBIJAKAN BILLING — WAJIB DIPATUHI (3 Agu 2026):
# Untuk SEMUA provider AI di bawah (ChatGPT, Kimi, Qwen, DeepSeek, Claude):
# DILARANG KERAS melakukan auto-recharge/auto-topup saat token/kredit habis,
# baik lewat kode, script, maupun UI otomatis apa pun. Saat kuota habis:
#   -> service melempar error -> provider chain jatuh ke provider berikutnya
#      (lihat aiProviderService.js) -> akhirnya fallback ke Private Agent.
# Isi ulang kredit HANYA dilakukan manual oleh owner lewat dashboard billing
# masing-masing provider. JANGAN pernah menambahkan kode yang memanggil
# endpoint billing/payment provider mana pun secara otomatis.
# CHAT_GPT_API_KEY=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
CHAT_GPT_API_KEY=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
# ⚠️ 3 Agu 2026: 'gpt-oss-20b' DAN 'gpt-5.6-terra-pro' dites LANGSUNG ke API
# Responses ini — keduanya HTTP 400 "The requested model '...' does not exist."
# Dites juga 'gpt-4o-mini' dan 'gpt-4.1-mini' → KEDUANYA berhasil. Diset ke
# gpt-4o-mini (sudah teruji stabil di sesi-sesi sebelumnya, termasuk analisis
# batas TPM). Ganti ke gpt-4.1-mini bila ingin mencoba varian lain — sama-sama
# terverifikasi jalan dengan key ini.
CHAT_GPT_MODEL=gpt-4o-mini
CHAT_GPT_STORE_RESPONSE=true
CHAT_GPT_MAX_OUTPUT_TOKENS=4096

CLAUDE_API_KEY=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
