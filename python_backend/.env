# ==============================================================
# FONNTE SEND — Timeout & Retry untuk pengiriman pesan WhatsApp
# ==============================================================
# FONNTE_TIMEOUT_MS   : waktu tunggu koneksi per percobaan (ms)
#                       Default 30000 (30 detik)
# FONNTE_RETRY_COUNT  : jumlah percobaan ulang jika ETIMEDOUT / ECONNRESET
#                       Default 3 (total 3 kali, termasuk percobaan pertama)
# FONNTE_RETRY_DELAY_MS : jeda awal antar percobaan (ms) — meningkat linear
#                         Percobaan 1→2: 1× delay, 2→3: 2× delay, dst.
#                         Default 3000 (3 detik, 6 detik, ...)
FONNTE_TIMEOUT_MS=30000
FONNTE_RETRY_COUNT=3
FONNTE_RETRY_DELAY_MS=3000

# ==============================================================
# MASSEGE_TERMINAL — Platform mana yang tampil di terminal
# ==============================================================
# Nilai: FONNTE | TIMELINESAI | KIRIMI (satu atau lebih, pisah koma)
# FONNTE      = fonnteChatController.js menampilkan chat di terminal
# KIRIMI      = kirimiChatController.js menampilkan chat di terminal
# TIMELINESAI = timelinesAIChatController.js menampilkan chat di terminal
#
# Contoh satu platform  : MASSEGE_TERMINAL=FONNTE
# Contoh multi platform : MASSEGE_TERMINAL=FONNTE,KIRIMI,TIMELINESAI
MASSEGE_TERMINAL=KIRIMI

SKILL_MAX_WEBSITE_CHARACTERS=12000
# Dinaikkan 260000→330000 (Juli 2026): baseline wajib claude_responds/chat_gpt_responds
# (SKILL.md + docs 01-15, tanpa file kondisional 16-19) sudah ~250K sendiri — headroom lama
# (10K) tidak cukup begitu 2+ file kondisional (fasilitas+lokasi) terpicu bersamaan dalam
# satu pesan customer, menyebabkan bagian akhir skill docs (biasanya doc 16-19) terpotong
# diam-diam. 330000 memberi ruang untuk worst-case SEMUA file kondisional termuat sekaligus.
SKILL_MAX_RESPONSE_CHARACTERS=330000
SKILL_MAX_PROJECT_CHARACTERS=345000

