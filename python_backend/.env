# ==============================================================
# QWEN (Alibaba Cloud) — DashScope OpenAI-compat / Bailian App
# ==============================================================
# Dua opsi key:
#   A) DashScope standard API key  → format: sk-xxxx... (alphanumeric)
#      Endpoint: dashscope.aliyuncs.com/compatible-mode/v1
#      Tidak perlu QWEN_APP_ID
#      Dapatkan di: console.aliyun.com → DashScope → API Keys
#
#   B) Bailian Workspace Secret Key → format: sk-ws-... (sudah di-set di bawah)
#      Endpoint: bailian.aliyuncs.com/v2/app/completions
#      WAJIB isi QWEN_APP_ID (App ID dari Bailian console)
#      Dapatkan App ID di: bailian.console.aliyun.com → Aplikasi → detail app
#
# International (QwenCloud/Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China mainland:                       https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-ws-H.YDPYDX.dOzG.MEQCIAoNzanjPT8tWaIB7QRlS7zLXx90hU2r8RlegSffnsFMAiA4jpJqP1D7q8keg1JUHRVdBGfBZ6Yq0lHkA8p6Tm3ReA
# Hanya diperlukan jika menggunakan sk-ws-* key (Bailian App):
# QWEN_APP_ID=ISI_APP_ID_DARI_BAILIAN_CONSOLE  ← bukan kode error, tapi ID aplikasi
# Model: qwen2-1.5b-instruct | qwen3-vl-flash | qwen3.7-plus | qwen2-1.5B-instruct
QWEN_MODEL=qwen3-vl-flash
# Batas token maksimal
QWEN_MAX_TOKENS=4096

# ============================================
# KONFIGURASI DEEPSEEK (Jangan sampai kosong)
# ============================================
# 1. API KEY - Dapatkan dari https://platform.deepseek.com/apikeys
DEEPSEEK_API_KEY=sk-06798d84b7214967a1c3ae7f363a4011
# 2. BASE URL - Endpoint resmi DeepSeek
# (Jika pakai gateway/proxy sendiri, ganti dengan URL proxy Anda)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model yang tersedia resmi:
# Model yang tersedia resmi:
# - deepseek-chat       → Model V3 terbaru (default terbaik untuk umum)
# - deepseek-reasoner   → Model R1 (untuk logika/penalaran mendalam)
# - deepseek-v3.1       → Versi terbaru V3 (jika sudah dirilis di akun Anda)
# - qwen2-1.5B-instruct
#
# ⚠️ Dites LANGSUNG ke API resmi ini (3 Agu 2026): 'deepseek-chat' DAN
# 'deepseek-v4-flash' KEDUANYA berhasil dengan key ini — jadi catatan lama
# yang bilang v4-flash "tidak tersedia" TIDAK akurat untuk akun ini. Biarkan
# deepseek-chat aktif (sudah terverifikasi); ini hanya koreksi catatan.
# Jika Anda menggunakan OpenRouter atau proxy lain, sesuaikan namanya.
DEEPSEEK_MODEL=deepseek-chat
# Maksimum token keluaran (output).
# Maksimal resmi: 8192 token untuk deepseek-chat, 8192 untuk deepseek-reasoner.
# 1200 terlalu kecil, saya sarankan minimal 4096 untuk kebutuhan umum.
DEEPSEEK_MAX_TOKENS=4096
# Suhu kreativitas (0.0 - 2.0). Default = 1.0
# 0.2 = faktual/konsisten, 1.0 = kreatif, 1.5 = sangat imajinatif
DEEPSEEK_TEMPERATURE=1.0
# Top-P (nucleus sampling). Default = 1.0
# Biarkan 1.0 jika tidak ingin mengubah perilaku default.
DEEPSEEK_TOP_P=1.0

# ============================================
# KONFIGURASI KIMI / Moonshot AI (Jangan sampai kosong)
# ============================================
KIMI_API_KEY=sk-BjOUZW3JIiDGLT7Kh46iIk885aOcNO9OQ3v2FMVAar3wJZDG
# ⚠️ "kimi-k2-thinking" DITOLAK API ini (404 "Not found the model ... or
# Permission denied") — dites langsung ke endpoint sebelum dipakai. Diganti ke
# kimi-k3 (rekomendasi resmi Moonshot untuk pemakaian umum, TERBUKTI jalan
# dengan API key ini). kimi-k2.6 dan kimi-k2.7-code-highspeed juga terbukti
# jalan bila ingin varian lain.
KIMI_MODEL=kimi-k2.6  # kimi-k3
# Base URL resmi Moonshot AI (OpenAI-compatible, endpoint /chat/completions):
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MAX_TOKENS=4096
KIMI_TEMPERATURE=1.0
# ⚠️ kimi-k3 HANYA menerima top_p=0.95 (API menolak nilai lain dengan
# "invalid top_p: only 0.95 is allowed for this model"). Jangan ubah ke 1.0.
KIMI_TOP_P=0.95

