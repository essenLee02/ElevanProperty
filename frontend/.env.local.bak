# Frontend app
VITE_APP_NAME=Propmatches Assistance
VITE_APP_ENV=local
# VITE_APP_ENV=production

# VITE_BACKEND_URL : origin backend yang dipanggil browser pengunjung.
# Dibaca src/services/backendBaseUrl.js (dipakai api.js/authApi.js/profileApi.js)
# untuk menyusun baseURL. ⚠️ NILAI INI DIBAKUKAN SAAT BUILD (`npm run build`) —
# mengubahnya di server SETELAH build tidak berpengaruh; harus build ulang lalu
# upload ulang isi frontend/dist/ ke public_html.
#   VITE_BACKEND_PORT KOSONG + VITE_BACKEND_URL berawalan https:// → TANPA port
#   ditempel (mis. https://propmatches.fun/api) — port standar 443 di balik
#   proxy Hostinger. Mengisi port di sini untuk domain https:// akan diabaikan
#   secara sengaja oleh backendBaseUrl.js, JADI dikosongkan saja di bawah.
VITE_BACKEND_URL=http://localhost
VITE_BACKEND_PORT=5055
# VITE_BACKEND_URL=https://propmatches.fun
# VITE_BACKEND_PORT=

# Vite dev server settings
VITE_DEV_SERVER_HOST=localhost # Domain saya di Hostinger : propmatches.fun
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_STRICT_PORT=true
VITE_DEV_SERVER_OPEN=false

# Vite preview server settings
VITE_PREVIEW_HOST=localhost # Domain saya di Hostinger : propmatches.fun
VITE_PREVIEW_PORT=4173
VITE_PREVIEW_STRICT_PORT=true
